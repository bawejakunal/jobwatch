# Copy to .env in the working directory or export in the scheduler.
# jobwatch loads .env from the current directory, then $JOBWATCH_HOME/.env.

# JOBWATCH_CONFIG=/path/to/companies.yaml
# JOBWATCH_DB=/path/to/jobwatch.sqlite
# JOBWATCH_HOME=~/.config/jobwatch

# Optional digest hooks (Phase 2 — parsed today, unused until wired)
# JOBWATCH_SLACK_WEBHOOK_URL=
# JOBWATCH_SMTP_HOST=
# JOBWATCH_SMTP_USER=
# JOBWATCH_SMTP_PASSWORD=
# JOBWATCH_MAIL_TO=
# JOBWATCH_MAIL_FROM=

# Optional LLM fallback (Phase 3 — BYOK, off by default)
# JOBWATCH_LLM_PROVIDER=openai
# JOBWATCH_LLM_API_KEY=
# JOBWATCH_LLM_MODEL=
